{
  "name": "dsh-provider-usage",
  "version": "0.3.0",
  "description": "DSH 插件（用量中心）：悬浮鲸鱼 · 供应商用量/余额/套餐查询（当前支持 OpenCode Go，对齐 cc-switch 查询语义）",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node tests/host.test.mjs && node tests/smoke.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
