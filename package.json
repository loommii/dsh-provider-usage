{
  "name": "dsh-provider-usage",
  "version": "0.1.7",
  "description": "DSH 插件：悬浮鲸鱼点击弹出 OpenCode Go 用量查询（M1 最简版，对齐 cc-switch 查询语义）",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node tests/host.test.mjs && node tests/smoke.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6"
  }
}
